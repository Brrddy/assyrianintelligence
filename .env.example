# --- Shop: Printful + Stripe (set these in Vercel → Settings → Environment Variables) ---
PRINTFUL_TOKEN=            # developers.printful.com → private token (scopes: orders, sync_products)
# PRINTFUL_STORE_ID=       # only if your token covers more than one Printful store
PRINTFUL_CONFIRM_ORDERS=false   # true = paid orders go straight to production; false = drafts you approve in Printful

STRIPE_SECRET_KEY=         # Stripe → Developers → API keys (sk_test_... first, then sk_live_...)
STRIPE_WEBHOOK_SECRET=     # Stripe → Developers → Webhooks → your endpoint → signing secret (whsec_...)
STRIPE_AUTOMATIC_TAX=false # true once Stripe Tax is set up

NEXT_PUBLIC_SITE_URL=https://assyrianintelligence.com

# --- Newsletter ---
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=
